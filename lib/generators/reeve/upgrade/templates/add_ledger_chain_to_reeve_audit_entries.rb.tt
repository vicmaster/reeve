# frozen_string_literal: true

# Audit-entry contract 2 → 3. Generated by `bin/rails generate reeve:upgrade`.
#
# Chains every row reeve writes from here on to the one before it with a keyed digest, so a
# row changed, removed or reordered outside reeve is reported by
# `bin/rails reeve:verify_ledger`.
#
# Rows already in the table are not touched: there is no honest digest to give a row
# nobody was there to sign, and nothing is backfilled into an append-only table. They are
# reported as "not covered" from now on — exactly as trustworthy as they were before this
# migration, and no more. The three columns are nullable for that reason.
#
# The chain needs a key, held outside the database. Add this to
# config/initializers/reeve.rb, or every guarded call fails closed after you migrate:
#
#   config.ledger_key = Rails.application.key_generator.generate_key("reeve audit ledger", 32)
#
# The chain record's head moves on every write, so the role your application connects as
# needs UPDATE on reeve_audit_chains (the ledger itself stays INSERT, SELECT):
#
#   GRANT INSERT, SELECT, UPDATE ON reeve_audit_chains TO app_role;
#
# A role holding that UPDATE can rewind the head, and a rewound head hides the deletion of
# the newest rows. Tamper-evidence detects a change after the fact; the grants are what
# prevent one.
#
# On a very large ledger, the unique index below scans the table once. On PostgreSQL that
# scan blocks writes for its duration; to avoid it, add `disable_ddl_transaction!` to this
# class and `algorithm: :concurrently` to the add_index call.
class AddLedgerChainToReeveAuditEntries < ActiveRecord::Migration[7.0]
  def change
    add_column :reeve_audit_entries, :chain_sequence, :bigint
    add_column :reeve_audit_entries, :chain_key_id,   :string, limit: 16
    add_column :reeve_audit_entries, :chain_digest,   :string, limit: 64
    add_index  :reeve_audit_entries, :chain_sequence, unique: true

    create_table :reeve_audit_chains do |t|
      t.string   :name,                      null: false
      t.datetime :genesis_at,                null: false, precision: 6
      t.bigint   :pre_chain_count,           null: false
      t.bigint   :pre_chain_unchained_count, null: false
      t.string   :genesis_key_id,            null: false, limit: 16
      t.string   :genesis_digest,            null: false, limit: 64
      t.bigint   :head_sequence,             null: false
      t.string   :head_digest,               null: false, limit: 64
    end

    add_index :reeve_audit_chains, :name, unique: true
  end
end
