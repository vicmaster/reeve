# frozen_string_literal: true

# Audit-entry contract 3 → 4. Generated by `bin/rails generate reeve:upgrade`.
#
# Records which key signed which stretch of the chain. Each key that signs the ledger opens
# a numbered key epoch, recorded once in reeve_audit_chain_epochs, and every row reeve chains
# from here on names its epoch in `chain_epoch`, inside its digest. Verification then reports
# a row whose key or epoch was changed as tampering, where before it could only say the row
# was signed by a key it did not have.
#
# Rows already in the table are not touched. Rows chained before the first epoch opens keep
# exactly the verification they had; the column is nullable for that reason. The first
# chained write after this migration opens epoch 0 with the configured ledger key.
#
# Rotate the key with `bin/rails reeve:rotate_ledger_key` (see the CHANGELOG).
#
# The application role needs INSERT and SELECT on the new table, never UPDATE:
#
#   GRANT INSERT, SELECT ON reeve_audit_chain_epochs TO app_role;
class AddKeyEpochsToReeveAuditEntries < ActiveRecord::Migration[7.0]
  def change
    add_column :reeve_audit_entries, :chain_epoch, :integer

    create_table :reeve_audit_chain_epochs do |t|
      t.integer  :epoch,          null: false
      t.string   :key_id,         null: false, limit: 16
      t.bigint   :first_sequence, null: false
      t.datetime :opened_at,      null: false, precision: 6
      t.string   :epoch_digest,   null: false, limit: 64
    end

    add_index :reeve_audit_chain_epochs, :epoch, unique: true
    add_index :reeve_audit_chain_epochs, :key_id, unique: true
  end
end
