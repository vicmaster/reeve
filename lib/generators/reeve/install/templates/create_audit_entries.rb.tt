# frozen_string_literal: true

# The reeve audit ledger: one row per guarded tool invocation, allowed or denied.
#
# The table is yours. Reeve writes to it and reads from it, and exposes no API that
# updates or deletes a row (FR-010). What the library can enforce, it enforces:
# Reeve::Audit::Entry is readonly once persisted and aborts destroy. What it cannot
# enforce, it does not pretend to — a database superuser or a raw `UPDATE` can still
# rewrite history. If the ledger is a compliance artifact for you, close that gap in the
# database, not in Ruby:
#
#   -- PostgreSQL, for the role your application connects as
#   REVOKE ALL   ON reeve_audit_entries FROM app_role;
#   GRANT INSERT, SELECT ON reeve_audit_entries TO app_role;
#   GRANT USAGE  ON SEQUENCE reeve_audit_entries_id_seq TO app_role;
#   -- the chain record: its head moves on every write
#   GRANT INSERT, SELECT, UPDATE ON reeve_audit_chains TO app_role;
#   GRANT USAGE  ON SEQUENCE reeve_audit_chains_id_seq TO app_role;
#   -- the key epochs: written once each, never updated
#   GRANT INSERT, SELECT ON reeve_audit_chain_epochs TO app_role;
#   GRANT USAGE  ON SEQUENCE reeve_audit_chain_epochs_id_seq TO app_role;
#   -- retention records: the application only reads them
#   GRANT SELECT ON reeve_audit_retentions TO app_role;
#
#   -- the retention role, used only by `bin/rails reeve:purge_ledger`
#   GRANT SELECT ON reeve_audit_entries, reeve_audit_chains, reeve_audit_chain_epochs,
#                   reeve_audit_retentions TO retention_role;
#   GRANT DELETE ON reeve_audit_entries TO retention_role;
#   GRANT INSERT ON reeve_audit_retentions TO retention_role;
#   GRANT USAGE  ON SEQUENCE reeve_audit_retentions_id_seq TO retention_role;
#
# Every row is chained to the one before it with a keyed digest, and names the key epoch
# that signed it (audit-entry contract 4),
# so a row changed, removed or reordered outside reeve is reported by
# `bin/rails reeve:verify_ledger`. That is tamper-evidence, not tamper-proofing: it
# detects a change after the fact and prevents nothing — the grant above is what
# prevents. It does not detect a change made by someone holding the ledger key, nor the
# newest rows being deleted by a role that can also rewind the head in
# reeve_audit_chains; that role needs UPDATE there, which is why the chain table is
# granted separately from the ledger.
#
# The table grows until you purge it. Deleting rows by hand breaks the chain by design and
# is reported as tampering; `bin/rails reeve:purge_ledger` removes the oldest entries up to
# a checkpoint, archives them, and leaves a signed record in reeve_audit_retentions so the
# rest still verifies. It runs on the retention role above, never the application's.
#
# `invocation_id` is a UUID stored as a string rather than a native `uuid` column,
# because reeve supports every database ActiveRecord does and only PostgreSQL has the
# native type. The unique index on it is what makes "exactly one row per invocation"
# a checkable property.
class CreateReeveAuditEntries < ActiveRecord::Migration[7.0]
  def change
    create_table :reeve_audit_entries do |t|
      t.string   :invocation_id,  null: false
      t.datetime :occurred_at,    null: false

      t.string   :agent_id,       null: false
      t.string   :agent_name
      t.string   :principal_type
      t.string   :principal_id

      t.string   :tool_name,      null: false
      t.json     :arguments,      null: false

      t.string   :outcome,        null: false
      t.string   :rule,           null: false
      # Diagnostic text explaining the rule ("policy raised ArgumentError: boom").
      # Nullable and free-form: match on `rule`, read `detail`. Never names a record.
      t.text     :detail

      t.string   :record_type
      t.json     :record_ids,     null: false
      t.integer  :record_count,   null: false, default: 0
      t.boolean  :truncated,      null: false, default: false
      t.boolean  :derived,        null: false, default: false

      t.string   :guard,          null: false
      t.integer  :duration_ms
      t.json     :metadata

      # The audit-entry contract version this row was written under. A ledger outlives
      # the gem version that wrote it, and a row that cannot name its own shape has to be
      # interpreted by guesswork: contract 1 wrote `metadata` NULL whatever the caller
      # passed, so on a version 1 row NULL means "never recorded" and on a version 2 row
      # it means "the caller passed none". Stamping each row keeps an export readable
      # across an upgrade instead of collapsing that distinction.
      t.integer  :contract_version, null: false

      # The chain (contract 3). Nullable: a row written before the chain began has no
      # honest value for these, and nothing is backfilled into an append-only table.
      # `chain_key_id` is the key's fingerprint, never the key.
      t.bigint   :chain_sequence
      t.string   :chain_key_id,   limit: 16
      t.string   :chain_digest,   limit: 64

      # The key epoch whose key signed the row (contract 4), inside the digest. Nullable for
      # the same reason as the chain columns, and NULL on an unchained row.
      t.integer  :chain_epoch
    end

    add_index :reeve_audit_entries, :invocation_id, unique: true

    # One index per query axis in FR-013: by principal, by tool, by agent, by outcome —
    # each paired with occurred_at, since every one of those questions is asked over a
    # time range.
    add_index :reeve_audit_entries, %i[principal_type principal_id occurred_at],
              name: "index_reeve_audit_entries_on_principal"
    add_index :reeve_audit_entries, %i[tool_name occurred_at]
    add_index :reeve_audit_entries, %i[agent_id occurred_at]
    add_index :reeve_audit_entries, %i[outcome occurred_at]

    # One position, one row. NULLs are distinct, so unchained rows never collide; the
    # index also orders the walk `reeve:verify_ledger` makes.
    add_index :reeve_audit_entries, :chain_sequence, unique: true

    # The chain record: one row. The genesis columns are written once, when the first
    # chained entry is; the head moves with every chained write, in the same transaction
    # as the row it points at.
    create_table :reeve_audit_chains do |t|
      t.string   :name,                      null: false
      t.datetime :genesis_at,                null: false, precision: 6
      t.bigint   :pre_chain_count,           null: false
      t.bigint   :pre_chain_unchained_count, null: false
      t.string   :genesis_key_id,            null: false, limit: 16
      t.string   :genesis_digest,            null: false, limit: 64
      t.bigint   :head_sequence,             null: false
      t.string   :head_digest,               null: false, limit: 64
    end

    add_index :reeve_audit_chains, :name, unique: true

    # One row per key that has signed the ledger (contract 4): written when the key first
    # signs, or by `bin/rails reeve:rotate_ledger_key`, and never updated. A key opens one
    # epoch only, hence the unique key_id.
    create_table :reeve_audit_chain_epochs do |t|
      t.integer  :epoch,          null: false
      t.string   :key_id,         null: false, limit: 16
      t.bigint   :first_sequence, null: false
      t.datetime :opened_at,      null: false, precision: 6
      t.string   :epoch_digest,   null: false, limit: 64
    end

    add_index :reeve_audit_chain_epochs, :epoch, unique: true
    add_index :reeve_audit_chain_epochs, :key_id, unique: true

    create_table :reeve_audit_retentions do |t|
      t.integer  :purge,             null: false
      t.bigint   :through_sequence,  null: false
      t.string   :through_digest,    null: false, limit: 64
      t.bigint   :previous_through,  null: false
      t.bigint   :removed_chained,   null: false
      t.bigint   :removed_pre_chain, null: false
      t.boolean  :archived,          null: false
      t.string   :archive_sha256,    limit: 64
      t.datetime :purged_at,         null: false, precision: 6
      t.string   :key_id,            null: false, limit: 16
      t.string   :retention_digest,  null: false, limit: 64
    end

    add_index :reeve_audit_retentions, :purge, unique: true
  end
end
